#!/bin/bash
# cek-izin — permission menu Darren.
# Izin dikendalikan penuh dari repo GitHub sendiri, bukan server luar.
# Sumber allowlist: https://raw.githubusercontent.com/ripzzsc/Darren/main/izin-install.txt
# Format (SATU format untuk install dan menu): satu IP per baris,
#   IP|Nama|TanggalExpired — tanggal format YYYY-MM-DD (contoh: 203.0.113.10|Budi|2027-01-31).
#   TanggalExpired kosong = tanpa batas (server owner). Baris # dan baris kosong diabaikan.
#   IP tidak ada di file = DITOLAK. Masa sewa habis = DITOLAK (berlaku sampai akhir tanggal expired).
#   Bila expired 7 hari lagi atau kurang, muncul peringatan tapi masih lolos.
# Real-time: cek SELALU ambil file baru dari GitHub dulu; cache lokal
# (/etc/xray/izin-cache.txt, TTL 1 jam) hanya cadangan bila GitHub tidak
# terjangkau. Bila cache kadaluarsa, DITOLAK. Catatan: setelah edit file di
# GitHub, CDN GitHub bisa menyajikan file lama sampai ±5 menit.
# Setiap baris allowlist divalidasi: format IP salah dan IP duplikat
# diabaikan (peringatan dicatat di log), supaya salah ketik tidak membuat
# penolakan yang membingungkan.
# Repo private: pasang token baca GitHub di /etc/xray/izin-token (mode 600).
# Token TIDAK PERNAH dicetak atau ditulis ke log oleh script ini.
# Keluar: 0 = lolos, 1 = ditolak (alasan dicetak jelas).

ALLOWLIST_URL="https://raw.githubusercontent.com/ripzzsc/Darren/main/izin-install.txt"
CACHE_FILE="/etc/xray/izin-cache.txt"
TOKEN_FILE="/etc/xray/izin-token"
CACHE_TTL=3600
LOG_FILE="/var/log/izin.log"

# IP privat (RFC1918 + loopback + link-local): tidak pernah ada di allowlist.
is_private_ip() {
  local ip="$1"
  case "$ip" in
    10.*|127.*|192.168.*|169.254.*) return 0 ;;
    172.16.*|172.17.*|172.18.*|172.19.*|172.2[0-9].*|172.30.*|172.31.*) return 0 ;;
  esac
  return 1
}

detect_ip() {
  local ip="" cand=""
  # 1. ipsave — hanya dipakai bila berisi IP publik.
  if [ -f /usr/bin/ipsave ]; then
    cand="$(grep -m1 -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' /usr/bin/ipsave 2>/dev/null)"
    if [ -n "$cand" ] && ! is_private_ip "$cand"; then ip="$cand"; fi
  fi
  # 2. Alamat lokal — ambil yang publik dulu (VPS NAT hanya punya IP privat di interface).
  if [ -z "$ip" ]; then
    for cand in $(hostname -I 2>/dev/null); do
      case "$cand" in
        *.*.*.*) is_private_ip "$cand" || { ip="$cand"; break; } ;;
      esac
    done
  fi
  # 3. Tanya ke luar (VPS di belakang NAT: IP publik tidak ada di interface lokal).
  if [ -z "$ip" ]; then
    cand="$(curl -fsSL --max-time 8 https://ifconfig.me 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "$cand" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && ! is_private_ip "$cand"; then ip="$cand"; fi
  fi
  # 4. Darurat: IP lokal pertama (privat) supaya pesan penolakan menyebut IP yang terdeteksi.
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -m1 -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$')"
  fi
  echo "$ip"
}

# Validasi tanggal kalender format YYYY-MM-DD (tolak 2026-02-30, 2026-13-01, 31-01-2027).
valid_tanggal() {
  local d="$1"
  [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
  [ "$(date -d "$d" +%F 2>/dev/null)" = "$d" ] || return 1
  return 0
}

# Ambil kolom tanggal expired (kolom ke-3) dari satu baris allowlist; kosong bila tidak ada.
kolom_expired() {
  local rest="${1#*|}"
  [ "$rest" = "$1" ] && { echo ""; return; }
  case "$rest" in *"|"*) echo "${rest##*|}";; *) echo "";; esac
}

# Validasi satu alamat IPv4 (4 oktet 0-255, tanpa nol di depan).
valid_ipv4() {
  local ip="$1"
  [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  local o
  for o in "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"; do
    [[ "$o" =~ ^0[0-9] ]] && return 1
    ((10#$o > 255)) && return 1
  done
  return 0
}

MYIP="$(detect_ip)"

log() { echo "$(date -Iseconds) ip=${MYIP:-?} hasil=$1 alasan=$2" >> "$LOG_FILE" 2>/dev/null || true; }

deny() {
  echo "IZIN DITOLAK: $1"
  echo "${2:-Perbaiki: tambahkan IP ini ke izin-install.txt di repo Darren (format: IP|Nama|TanggalExpired, satu per baris), tunggu ±5 menit bila baru di-commit (cache CDN GitHub), lalu jalankan ulang menu.}"
  log "DITOLAK" "$1"
  exit 1
}

[ -z "$MYIP" ] && deny "IP IPv4 VPS tidak terdeteksi"

# VPS di belakang NAT (mis. Tencent Lighthouse) hanya punya IP privat di
# interface lokal; izin memakai IP publik, jadi IP privat pasti ditolak.
if is_private_ip "$MYIP"; then
  deny "IP yang terdeteksi ($MYIP) adalah IP privat — VPS ini di belakang NAT, sedangkan izin memakai IP publik" "Perbaiki: tulis IP publik VPS ini ke /usr/bin/ipsave (misal: echo 1.2.3.4 > /usr/bin/ipsave), atau pastikan VPS bisa mengakses https://ifconfig.me, lalu jalankan ulang menu."
fi

TOKEN=""
if [ -r "$TOKEN_FILE" ]; then
  TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null)"
fi
AUTH_ARGS=()
[ -n "$TOKEN" ] && AUTH_ARGS=(-H "Authorization: Bearer $TOKEN")

# Ambil allowlist terbaru; bila gagal, pakai cache bila masih berlaku.
FETCH_OK=0
HTTP_CODE="$(curl -sSL -o "${CACHE_FILE}.tmp" -w "%{http_code}" --max-time 15 "${AUTH_ARGS[@]}" "$ALLOWLIST_URL" 2>/dev/null)"
[ "$HTTP_CODE" = "200" ] && mv "${CACHE_FILE}.tmp" "$CACHE_FILE" 2>/dev/null && FETCH_OK=1
[ "$FETCH_OK" -eq 0 ] && rm -f "${CACHE_FILE}.tmp"
if [ "$FETCH_OK" -eq 0 ]; then
  if [ -f "$CACHE_FILE" ]; then
    AGE=$(( $(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0) ))
    [ "$AGE" -gt "$CACHE_TTL" ] && deny "allowlist tidak terjangkau (HTTP $HTTP_CODE) dan cache sudah kadaluarsa"
  else
    deny "allowlist tidak terjangkau (HTTP $HTTP_CODE) dan belum ada cache"
  fi
fi

# Bersihkan allowlist: buang baris format salah + duplikat (peringatan
# dicatat di log dan stderr), supaya yang dicocokkan hanya entri valid.
CLEAN_FILE="${CACHE_FILE}.bersih"
: > "$CLEAN_FILE" 2>/dev/null || deny "tidak bisa menulis $CLEAN_FILE"
_valid=0
_lineno=0
declare -A _seen=()
while IFS= read -r _raw || [ -n "$_raw" ]; do
  _lineno=$((_lineno + 1))
  _line="${_raw#"${_raw%%[![:space:]]*}"}"
  _line="${_line%"${_line##*[![:space:]]}"}"
  [ -z "$_line" ] && continue
  case "$_line" in \#*) continue;; esac
  _ip="${_line%%|*}"
  if ! valid_ipv4 "$_ip"; then
    echo "PERINGATAN: izin-install.txt baris $_lineno diabaikan (format IP tidak valid): $_line" >&2
    log "PERINGATAN" "baris $_lineno format salah: $_line"
    continue
  fi
  if [ -n "${_seen[$_ip]:-}" ]; then
    echo "PERINGATAN: izin-install.txt baris $_lineno diabaikan (IP duplikat, dipakai baris pertama): $_line" >&2
    log "PERINGATAN" "baris $_lineno duplikat: $_line"
    continue
  fi
  _exp="$(kolom_expired "$_line")"
  if [ -n "$_exp" ] && ! valid_tanggal "$_exp"; then
    echo "PERINGATAN: izin-install.txt baris $_lineno diabaikan (tanggal expired tidak valid, pakai YYYY-MM-DD): $_line" >&2
    log "PERINGATAN" "baris $_lineno tanggal salah: $_line"
    continue
  fi
  _seen[$_ip]=1
  printf '%s\n' "$_line" >> "$CLEAN_FILE"
  _valid=$((_valid + 1))
done < "$CACHE_FILE"
[ "$_valid" -eq 0 ] && deny "allowlist tidak berisi entri IP yang valid (periksa format izin-install.txt di GitHub)"

# Cocokkan IP persis di awal baris (titik di-escape) pada daftar bersih.
MYIP_ESC="${MYIP//./\\.}"
LINE="$(grep -m1 -E "^${MYIP_ESC}(\\|.*)?$" "$CLEAN_FILE" 2>/dev/null || true)"
[ -z "$LINE" ] && deny "IP $MYIP tidak terdaftar di allowlist"

NAMA="${LINE#*|}"
if [ "$NAMA" = "$LINE" ]; then
  NAMA=""
else
  NAMA="${NAMA%%|*}"
fi

# Masa sewa: berlaku sampai AKHIR tanggal expired (tanggal VPS).
EXP="$(kolom_expired "$LINE")"
if [ -n "$EXP" ]; then
  _today="$(date +%F)"
  _sisa=$(( ($(date -d "$EXP" +%s) - $(date -d "$_today" +%s)) / 86400 ))
  if [ "$_sisa" -lt 0 ]; then
    deny "masa sewa script untuk IP $MYIP habis pada $EXP" "Perpanjang: ubah tanggal expired IP ini di izin-install.txt di repo Darren (format: IP|Nama|YYYY-MM-DD), tunggu ±5 menit bila baru di-commit (cache CDN GitHub), lalu jalankan ulang menu."
  fi
  if [ "$_sisa" -le 7 ]; then
    if [ "$_sisa" -eq 0 ]; then
      echo "PERINGATAN: masa sewa script habis HARI INI ($EXP), perpanjang di izin-install.txt." >&2
      log "PERINGATAN" "masa sewa habis hari ini ($EXP)"
    else
      echo "PERINGATAN: masa sewa script habis dalam $_sisa hari ($EXP), perpanjang di izin-install.txt." >&2
      log "PERINGATAN" "masa sewa habis dalam $_sisa hari ($EXP)"
    fi
  fi
fi

log "LOLOS" "server=${NAMA:-tanpa nama} expired=${EXP:-tanpa batas}"
exit 0
